{
  "name": "camy-entrepreneurs-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "api": "node scripts/run-php.mjs -S 127.0.0.1:8001 -t api api/index.php",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "node scripts/run-php.mjs scripts/setup-local-db.php",
    "db:reset": "node scripts/run-php.mjs scripts/setup-local-db.php --reset",
    "db:cleanup": "node scripts/run-php.mjs scripts/cleanup-legacy-tables.php",
    "db:recalculate-credit": "node scripts/run-php.mjs scripts/recalculate-credit.php",
    "php:version": "node scripts/run-php.mjs -v",
    "db:check": "node scripts/run-php.mjs scripts/check-local-db.php"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "exceljs": "^4.4.0",
    "lucide-react": "latest",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  }
}
