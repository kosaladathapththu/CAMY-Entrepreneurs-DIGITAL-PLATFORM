Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep one secure canonical origin for search engines.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.camymarket\.com$ [NC]
  RewriteRule ^ https://camymarket.com%{REQUEST_URI} [R=301,L]
  RewriteRule ^register/$ /register [R=301,L]

  # Serve indexable registration metadata before the private SPA fallback.
  RewriteRule ^register$ register.html [L]

  # The PHP API must be resolved before the React SPA fallback.
  RewriteRule ^api/?$ api/index.php [L,QSA]
  RewriteRule ^api/(.*)$ api/index.php [L,QSA]

  # Serve real build assets and public files normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All remaining URLs are client-side React routes.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  <FilesMatch "\.(?:css|js|png|jpe?g|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|register\.html|sw\.js|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<FilesMatch "(^\.|\.(?:env|ini|log|sql|bak|pem|key)$)">
  Require all denied
</FilesMatch>
